+            report = tmp / "report.md"
+            write_csv(token_csv, result.token_rows)
+            write_csv(checkpoint_csv, result.checkpoint_rows)
+            write_manifest(
+                manifest,
+                result=result,
+                token_csv=token_csv,
+                checkpoint_csv=checkpoint_csv,
+            )
+            write_report(
+                report,
+                result=result,
+                token_csv=token_csv,
+                checkpoint_csv=checkpoint_csv,
+                manifest=manifest,
+            )
+            payload = json.loads(manifest.read_text(encoding="utf-8"))
