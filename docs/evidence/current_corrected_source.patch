+    "summary": "reports/benchmark/corrected/stress/long_trace_stress_summary.csv",
+    "manifest": "reports/benchmark/corrected/stress/long_trace_stress_summary_manifest.json",
+    "evidence_scope": "supplemental synthetic floating Q/DQ diagnostic"
