+        ROOT / "scripts" / "direct_rtl_trace_report.py",
+        ROOT / "scripts" / "verify_hls_command_trace.py",
+        *sorted((ROOT / "hls" / "include").glob("*.hpp")),
+        *sorted((ROOT / "hls" / "src").glob("*.cpp")),
+        *sorted((ROOT / "hls" / "tcl").glob("*.tcl")),
