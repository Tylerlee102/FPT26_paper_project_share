+        },
+        "simulator": {
+            "tool": "AMD XSIM",
+            "version": "2025.2",
+            "rtl_language": "verilog",
+            "xelab_slave_threads": 8,
+            "coverage": "ignored",
+            "assertions": "ignored",
+            **parsed["xsim_kernel"],
+        },
+        "parity": {
+            "status": "PASS",
+            "ordered_tokens": len(parsed["token_rows"]),
+            "output_mantissas_compared": 64 * 4096,
+            "output_exponents_compared": 64 * 4096,
+            "command_counters_compared": 64 * 8,
