+    "distribution": "normal",
+    "mean": 0.0,
+    "standard_deviation": 0.05
+  },
+  "zero_initial_state": {
+    "value": 0.0
+  },
+  "token_inputs": {
+    "query": {
+      "distribution": "normal",
+      "mean": 0.0,
+      "standard_deviation": 1.0,
+      "postprocess": "L2 normalize and divide by sqrt(key_dim)"
+    },
+    "key": {
+      "distribution": "normal",
+      "mean": 0.0,
+      "standard_deviation": 1.0,
+      "postprocess": "L2 normalize"
+    },
+    "value": {
+      "distribution": "normal",
+      "mean": 0.0,
+      "standard_deviation": 0.25
+    }
+  },
+  "trace_families": {
+    "nominal": {
+      "alpha_uniform": [0.95, 1.0],
+      "beta_uniform": [0.0, 1.0]
+    },
+    "high_retention": {
+      "alpha_uniform": [0.995, 1.0],
+      "beta_uniform": [0.85, 1.0]
+    },
+    "dynamic_range": {
+      "alpha_uniform": [0.95, 1.0],
+      "beta_uniform": [0.0, 1.0],
+      "value_scale_power": {
+        "formula": "(token_zero_based // 32) % 9 - 4",
+        "minimum": -4,
+        "maximum": 4,
+        "segment_tokens": 32,
+        "period_tokens": 288
+      }
+    },
+    "cancellation": {
+      "alpha_uniform": [0.95, 1.0],
+      "beta_uniform": [0.0, 1.0],
+      "transform": "q, k, and v become abs(input) times +1 on even zero-based tokens and -1 on odd zero-based tokens"
+    }
+  },
