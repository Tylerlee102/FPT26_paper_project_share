+        pdf.setFont("Helvetica", 5.9)
+        pdf.drawRightString(plot_x - 4.0, center_y - 2.0, label)
+        if value is None:
+            pdf.setFillColorRGB(0.38, 0.38, 0.38)
+            pdf.setFont("Helvetica-Oblique", 5.8)
+            pdf.drawString(plot_x + 3.0, center_y - 2.0, annotation)
