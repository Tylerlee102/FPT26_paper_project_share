+
+        sequence_output, sequence_state = gdn_decode_sequence(q, k, v, alpha, beta, state)
+        manual_state = state.copy()
+        manual_outputs = []
+        for token in range(q.shape[0]):
+            output, manual_state = gdn_decode_step(
