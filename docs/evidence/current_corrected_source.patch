+    "cosine_denominator_floor": 1e-24,
+    "output_reduction": "flatten all value heads and V coordinates",
+    "state_reduction": "flatten all value heads, K rows, and V columns",
+    "maximum_absolute_error_reduction": "maximum over the complete flattened tensor",
+    "identical_array_convention": {
+      "cosine": 1.0,
+      "relative_l2": 0.0,
+      "maximum_absolute_error": 0.0
