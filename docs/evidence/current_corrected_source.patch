+    "scripts/aggregate_e2m0_encoded_held_out.py"
+  ],
+  "rng": {
+    "library": "numpy",
+    "generator": "default_rng",
+    "bit_generator": "PCG64",
+    "construction": "one deterministic generator per token from seed, token index, and trace family"
+  },
+  "dimensions": {
+    "num_qk_heads": 16,
+    "num_value_heads": 32,
+    "key_dim": 128,
+    "value_dim": 128
+  },
+  "required_checkpoints": [64, 256, 1024, 4096, 8192],
