+    row = {
+        "value": value,
+        "units": units,
+        "source": relative,
+        "source_line": _line(source, marker),
+        "extractor": "scripts.corrected_paper_assets",
+        "git_sha": revision,
+        "timestamp": timestamp,
+    }
+    numbers[key] = row
