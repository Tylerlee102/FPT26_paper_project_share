+    tmp_path: Path,
+) -> None:
+    output = tmp_path / "tradeoff.pdf"
+    manifest_path = tmp_path / "tradeoff_manifest.json"
+    manifest = generate(
+        DEFAULT_CAPACITY,
+        DEFAULT_LONG_CHECKPOINTS,
