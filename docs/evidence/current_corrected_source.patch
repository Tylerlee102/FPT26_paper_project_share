+        "timestamp": timestamp,
+    }
+    numbers[key] = row
+    provenance[key] = dict(row)
+
+
+def _format(value: object, digits: int = 6) -> str:
+    if isinstance(value, float):
+        return f"{value:.{digits}f}"
+    return str(value)
+
+
+def _tex_integer(value: object) -> str:
+    return f"{int(value):,}".replace(",", r"{,}")
