+    def test_headline_energy_uses_board_tdp_basis(self) -> None:
+        numbers = json.loads(Path("paper/numbers.json").read_text(encoding="utf-8"))
+
+        latency_us = float(numbers["ours_mxfp4_b32_latency_us"]["value"])
+        onchip_power_w = float(numbers["ours_mxfp4_b32_onchip_power_w"]["value"])
+        board_tdp_power_w = float(numbers["u55c_board_tdp_power_w"]["value"])
+        onchip_energy_mj = onchip_power_w * latency_us / 1000.0
+        board_tdp_energy_mj = board_tdp_power_w * latency_us / 1000.0
+
+        self.assertEqual(numbers["ours_mxfp4_b32_onchip_energy_mj"]["units"], "mj_per_token_onchip")
+        self.assertEqual(numbers["ours_mxfp4_b32_energy_mj"]["units"], "mj_per_token_board_tdp")
+        self.assertAlmostEqual(
+            float(numbers["ours_mxfp4_b32_onchip_energy_mj"]["value"]),
+            round(onchip_energy_mj, 3),
+            places=3,
+        )
+        self.assertAlmostEqual(
+            float(numbers["ours_mxfp4_b32_energy_mj"]["value"]),
+            round(board_tdp_energy_mj, 3),
+            places=3,
+        )
+        self.assertAlmostEqual(
+            float(numbers["headline_energy_efficiency_vs_h100"]["value"]),
+            round(float(numbers["h100_baseline_energy_mj"]["value"]) / board_tdp_energy_mj, 3),
+            places=3,
+        )
+        self.assertLess(
+            float(numbers["headline_energy_efficiency_vs_h100"]["value"]),
+            float(numbers["diagnostic_onchip_energy_efficiency_vs_h100_tdp"]["value"]),
+        )
+
