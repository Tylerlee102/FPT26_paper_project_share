{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "type": "object",
      "required": ["value", "units", "source", "git_sha", "timestamp"],
      "properties": {
        "value": { "type": ["number", "string", "array"] },
        "units": { "type": "string" },
        "source": {
          "type": "string",
          "description": "relative path to source file"
        },
        "source_line": { "type": ["integer", "null"] },
        "extractor": {
          "type": "string",
          "description": "script that produced this number"
        },
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "uncertainty": {
          "type": "number",
          "description": "+/- value if applicable"
        },
        "notes": { "type": "string" }
      }
    }
  }
}

